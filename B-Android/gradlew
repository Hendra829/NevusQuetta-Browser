#!/usr/bin/env sh
# Gradle start-up generated for NevusQuetta B. Requires gradle-wrapper.jar beside this script.
APP_HOME=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
WRAPPER="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
if [ ! -f "$WRAPPER" ]; then
  echo "ERROR: $WRAPPER hilang. Unduh dari services.gradle.org atau jalankan: gradle wrapper --gradle-version 8.9" >&2
  exit 1
fi
JAVACMD=${JAVA_HOME:+$JAVA_HOME/bin/java}
JAVACMD=${JAVACMD:-java}
exec "$JAVACMD" -Xmx1536m -cp "$WRAPPER" org.gradle.wrapper.GradleWrapperMain "$@"
