# NevusQuetta PWA — aturan hosting Hostinger (LiteSpeed/Apache).
# Unggah berkas ini bersama index.html ke document root.

# ---------------------------------------------------------------------------
# 1. HTTPS wajib
# ---------------------------------------------------------------------------
RewriteEngine On

RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ---------------------------------------------------------------------------
# 2. www -> apex
# ---------------------------------------------------------------------------
# Manifest dan scope service worker terikat ke satu origin. Memakai dua nama
# host (apex + www) membuat instalasi PWA terlihat sebagai dua aplikasi berbeda.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ---------------------------------------------------------------------------
# 3. Service worker: JANGAN di-cache
# ---------------------------------------------------------------------------
# Bila service-worker.js di-cache browser, pembaruan aplikasi tidak akan pernah
# terdeteksi. Ini penyebab paling umum "sudah deploy tapi pengguna masih lihat
# versi lama".
<Files "service-worker.js">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Service-Worker-Allowed "/"
  </IfModule>
</Files>

# ---------------------------------------------------------------------------
# 4. Manifest
# ---------------------------------------------------------------------------
<Files "manifest.json">
  <IfModule mod_headers.c>
    Header set Content-Type "application/manifest+json"
    Header set Cache-Control "public, max-age=3600"
  </IfModule>
</Files>

# ---------------------------------------------------------------------------
# 5. Dokumen HTML: no-cache agar versi baru cepat terdeteksi
# ---------------------------------------------------------------------------
<FilesMatch "\.html$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
  </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------------
# 6. Aset statis: boleh di-cache lama
# ---------------------------------------------------------------------------
<FilesMatch "\.(png|jpg|jpeg|svg|webp|ico|woff2?|css|js)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=604800"
  </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------------
# 7. Header keamanan
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "DENY"
  Header set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
</IfModule>

# ---------------------------------------------------------------------------
# 8. Jangan tampilkan daftar direktori
# ---------------------------------------------------------------------------
Options -Indexes

# ---------------------------------------------------------------------------
# 9. Fallback navigasi (aplikasi satu halaman)
# ---------------------------------------------------------------------------
# Semua berkas memang ada di server, jadi aturan ini hanya jaring pengaman.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
